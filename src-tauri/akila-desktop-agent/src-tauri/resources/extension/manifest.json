{
  "manifest_version": 3,
  "name": "AKILA Privilege Guard",
  "version": "1.0.0",
  "key": "",
  "description": "Tokenizes client-identifying data before it reaches AI chat tools, and restores it in the response.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:5001/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["akila-universal-sieve.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["akila-page-interceptor.js"],
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"]
    }
  ]
}
