{
  "manifest_version": 3,
  "name": "AKILA Outbound Assurance MVP",
  "version": "0.2.0",
  "description": "Local outbound-data assurance for explicitly supported AI chat sites.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5171/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-guard.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "action": { "default_title": "AKILA Assurance" }
}