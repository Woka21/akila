{
  "manifest_version": 3,
  "name": "AKILA Privilege Guard",
  "version": "1.0.0",
  "key": "",
  "description": "Tokenizes client-identifying data before it reaches AI chat tools, and restores it in the response.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AKILA Privilege Guard"
  },
  "host_permissions": [
    "http://127.0.0.1:5001/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://api.perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://bing.com/*",
    "https://www.bing.com/*",
    "https://chat.huggingface.co/*",
    "https://huggingface.co/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://www.you.com/*",
    "https://phind.com/*",
    "https://www.phind.com/*",
    "https://writesonic.com/*",
    "https://www.writesonic.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://chat.huggingface.co/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://www.phind.com/*",
        "https://writesonic.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://chat.huggingface.co/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://www.phind.com/*",
        "https://writesonic.com/*",
        "https://docs.google.com/*"
      ],
      "js": ["akila-universal-sieve.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["akila-page-interceptor.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://chat.huggingface.co/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://www.phind.com/*",
        "https://writesonic.com/*",
        "https://docs.google.com/*"
      ]
    }
  ]
}
